# Impedir que se pueda ver el listado de contenidos de un directorio
Options -Indexes

# Activar el motor de reescritura de URLs de Apache
RewriteEngine On

# Definir la ruta base donde está este archivo .htaccess
RewriteBase /EIS_Zona_Web_Lara/src/

# Patrón MVC estricto: el único punto de entrada es index.php.
# Se prohíbe acceder directamente a controladores, modelos, vistas,
# configuración, scripts CLI, base de datos y dependencias.
RewriteRule ^(?:app|Config|cli|Database|vendor|logs)(?:/|$) - [F,L]
RewriteRule ^(?:composer\.(?:json|lock)|\.env.*|Dockerfile)$ - [F,L]

# Redirigir la raíz del sitio hacia index.php
RewriteRule ^$ index.php [L,QSA]

# Si el archivo o directorio solicitado no existe físicamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirigir hacia index.php pasando la página como parámetro
RewriteRule ^([\w-]+)$ index.php?pagina=$1 [L,QSA]