# ============================================================
# Variables de entorno para Docker Compose (EIS System)
# Copia este archivo a ".env" y ajusta los valores si quieres.
# NUNCA subas ".env" real al repositorio.
# ============================================================

# Puerto en el que se publicará la aplicación web
WEB_PORT=8080

# ------------------------------------------------------------
# MySQL (dentro del contenedor)
# ------------------------------------------------------------
# Credenciales usadas por la app para conectarse a la BD
DB_NAME=zona_web_lara
DB_USER=eis
DB_PASS=eis_secret

# Contraseña del usuario root del contenedor MySQL
MYSQL_ROOT_PASSWORD=root_secret

# Puerto externo opcional de MySQL (descomenta la sección "ports"
# de db en docker-compose.yml para habilitarlo)
# DB_PORT=3307